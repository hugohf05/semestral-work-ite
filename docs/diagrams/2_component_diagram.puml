@startuml
title Component Diagram - Modules and dependencies
!pragma layout smetana

[main.py\n(CLI: train / evaluate / predict)] as main
[app.py\n(Streamlit)] as app

package "src" {
  [data_loader.py] as loader
  [features.py] as features
  [models.py] as models
  [evaluation.py] as evaluation
  [predictor.py] as predictor
}

database "data/raw\n(Kaggle CSV)" as csv
file "models/model.joblib" as model
folder "reports/\n(CSV + PNG)" as reports

main --> loader
main --> features
main --> models
main --> evaluation
main --> predictor
app --> features
app --> predictor
features --> loader
models --> features
predictor --> features
loader ..> csv : reads
predictor ..> model : saves / loads
evaluation ..> reports : writes
app ..> reports : shows
@enduml
