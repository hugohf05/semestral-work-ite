@startuml
title Sequence Diagram - Player lookup in the app

actor User
participant "app.py" as App
participant "features.py" as Features
participant "predictor.py" as Predictor
participant "Random Forest\n(model.joblib)" as Model

== Start (cached, runs once) ==
App -> Predictor : load_model()
Predictor --> App : model
App -> Features : load_player_seasons()
Features --> App : player-season table

== Lookup ==
User -> App : name and season
opt season used in training
  App --> User : warning: prediction is optimistic
end
App -> Predictor : find_player(table, name, season)
alt no match or several players
  Predictor --> App : ValueError
  App --> User : error message
else one player
  Predictor --> App : player row (features + real value)
  App -> Predictor : predict_value(model, row)
  Predictor -> Model : predict(features)
  Model --> Predictor : log10(value)
  Predictor --> App : value in EUR (10^prediction)
  App --> User : real value, predicted value,\nratio and under/overvalued note
end
@enduml
